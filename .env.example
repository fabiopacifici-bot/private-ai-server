## Example .env file for AI Inference Server
# Set Hugging Face cache directory (change to desired drive/path)
HF_HOME=D:\ai-server-models

# Optional tuning
#MAX_CACHE_MODELS=1
#MODEL_Q4_THRESHOLD_BYTES=14000000000

MAX_GPU_MEMORY=12GiB
MAX_CPU_MEMORY=48GiB

# Quantization mode for the transformers fallback (auto | nf4 | fp16 | awq | exl2)
#   auto  -> NF4 4-bit for models >= MODEL_Q4_THRESHOLD_BYTES, else fp16 (default)
#   nf4   -> force 4-bit NF4 (needs bitsandbytes)
#   fp16  -> force fp16, no quantization
#   awq / exl2 -> engines NOT bundled; fall back to auto (integration point only)
#TRANSFORMERS_QUANT=auto

# Optional quantized KV-cache dtype for the transformers generate() path (int8/float8)
# "" (default) uses the model's default KV-cache. Opt-in and non-breaking.
#KV_CACHE_DTYPE=int8
# === Long-context support (250k-context roadmap) ===
# Maximum total tokens (prompt + generated) for the transformers backend.
# Default 250000 (the roadmap target). Clamped per-model to its native
# max_position_embeddings via RoPE linear scaling when extended.
#MAX_CONTEXT_LENGTH=250000

# Conversation context-management budget (tokens). When a chat request's
# cumulative token estimate exceeds this, older turns are evicted (system prompt
# + recent turns + running summary are kept).
#CONTEXT_BUDGET_TOKENS=120000
#CONTEXT_COMPACTION_MIN_TURNS=4

# Memory-efficient attention implementation for long context:
#   sdpa (default, torch built-in) | flash_attention_2 (needs flash-attn) | eager
#TRANSFORMERS_ATTN_IMPL=sdpa
